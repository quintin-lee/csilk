@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# ── Standard CMake Package Dependencies ──────────────────────────────────
find_dependency(Threads)
find_dependency(OpenSSL)
find_dependency(ZLIB)
find_dependency(SQLite3)
find_dependency(CURL)

if(TARGET SQLite::SQLite3 AND NOT TARGET SQLite3::SQLite3)
  add_library(SQLite3::SQLite3 INTERFACE IMPORTED)
  target_link_libraries(SQLite3::SQLite3 INTERFACE SQLite::SQLite3)
endif()
if(TARGET SQLite3::SQLite3 AND NOT TARGET SQLite::SQLite3)
  add_library(SQLite::SQLite3 INTERFACE IMPORTED)
  target_link_libraries(SQLite::SQLite3 INTERFACE SQLite3::SQLite3)
endif()

# ── JSON Engine (yyjson) ──────────────────────────────────────────────────
if(NOT TARGET yyjson::yyjson AND NOT TARGET yyjson)
  find_package(yyjson QUIET)
  if(NOT TARGET yyjson::yyjson AND NOT TARGET yyjson)
    if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/../yyjson/yyjson-config.cmake")
      include("${CMAKE_CURRENT_LIST_DIR}/../yyjson/yyjson-config.cmake")
    endif()
  endif()
endif()
if(TARGET yyjson AND NOT TARGET yyjson::yyjson)
  add_library(yyjson::yyjson INTERFACE IMPORTED)
  target_link_libraries(yyjson::yyjson INTERFACE yyjson)
endif()

# ── I/O Backend (libuv or io_uring) ──────────────────────────────────────
set(CSILK_USE_URING @CSILK_USE_URING@)
if(NOT CSILK_USE_URING AND NOT TARGET csilk::libuv)
  find_package(PkgConfig QUIET)
  if(PKG_CONFIG_FOUND)
    pkg_check_modules(LIBUV QUIET IMPORTED_TARGET libuv)
  endif()
  if(TARGET PkgConfig::LIBUV)
    add_library(csilk::libuv INTERFACE IMPORTED)
    target_link_libraries(csilk::libuv INTERFACE PkgConfig::LIBUV)
  else()
    find_library(LIBUV_LIB NAMES uv libuv)
    find_path(LIBUV_INCLUDE_DIR uv.h)
    if(LIBUV_LIB)
      add_library(csilk::libuv INTERFACE IMPORTED)
      if(LIBUV_INCLUDE_DIR)
        set_target_properties(csilk::libuv PROPERTIES INTERFACE_INCLUDE_DIRECTORIES "${LIBUV_INCLUDE_DIR}")
      endif()
      set_target_properties(csilk::libuv PROPERTIES INTERFACE_LINK_LIBRARIES "${LIBUV_LIB}")
    endif()
  endif()
endif()

# ── YAML Parser (libyaml) ─────────────────────────────────────────────────
if(NOT TARGET csilk::yaml)
  find_package(PkgConfig QUIET)
  if(PKG_CONFIG_FOUND)
    pkg_check_modules(YAML QUIET IMPORTED_TARGET yaml>=0.2.0)
  endif()
  if(TARGET PkgConfig::YAML)
    add_library(csilk::yaml INTERFACE IMPORTED)
    target_link_libraries(csilk::yaml INTERFACE PkgConfig::YAML)
  else()
    find_library(YAML_LIB NAMES yaml libyaml)
    find_path(YAML_INCLUDE_DIR yaml.h PATH_SUFFIXES yaml)
    if(YAML_LIB)
      add_library(csilk::yaml INTERFACE IMPORTED)
      if(YAML_INCLUDE_DIR)
        set_target_properties(csilk::yaml PROPERTIES INTERFACE_INCLUDE_DIRECTORIES "${YAML_INCLUDE_DIR}")
      endif()
      set_target_properties(csilk::yaml PROPERTIES INTERFACE_LINK_LIBRARIES "${YAML_LIB}")
    endif()
  endif()
endif()

# ── HTTP/1 Parser (llhttp) ────────────────────────────────────────────────
if(NOT TARGET csilk::llhttp)
  find_library(LLHTTP_LIB NAMES llhttp libllhttp)
  find_path(LLHTTP_INCLUDE_DIR llhttp.h)
  if(LLHTTP_LIB)
    add_library(csilk::llhttp INTERFACE IMPORTED)
    if(LLHTTP_INCLUDE_DIR)
      set_target_properties(csilk::llhttp PROPERTIES INTERFACE_INCLUDE_DIRECTORIES "${LLHTTP_INCLUDE_DIR}")
    endif()
    set_target_properties(csilk::llhttp PROPERTIES INTERFACE_LINK_LIBRARIES "${LLHTTP_LIB}")
  endif()
endif()

# ── HTTP/2 Engine (nghttp2) ───────────────────────────────────────────────
if(NOT TARGET nghttp2)
  find_package(PkgConfig QUIET)
  if(PKG_CONFIG_FOUND)
    pkg_check_modules(LIBNGHTTP2 QUIET IMPORTED_TARGET libnghttp2)
  endif()
  if(TARGET PkgConfig::LIBNGHTTP2)
    add_library(nghttp2 INTERFACE IMPORTED)
    target_link_libraries(nghttp2 INTERFACE PkgConfig::LIBNGHTTP2)
  else()
    find_library(NGHTTP2_LIB NAMES nghttp2 libnghttp2)
    find_path(NGHTTP2_INCLUDE_DIR nghttp2/nghttp2.h)
    if(NGHTTP2_LIB)
      add_library(nghttp2 INTERFACE IMPORTED)
      if(NGHTTP2_INCLUDE_DIR)
        set_target_properties(nghttp2 PROPERTIES INTERFACE_INCLUDE_DIRECTORIES "${NGHTTP2_INCLUDE_DIR}")
      endif()
      set_target_properties(nghttp2 PROPERTIES INTERFACE_LINK_LIBRARIES "${NGHTTP2_LIB}")
    endif()
  endif()
endif()

# ── Optional Database Drivers ─────────────────────────────────────────────
set(CSILK_HAS_MYSQL @CSILK_HAS_MYSQL@)
set(CSILK_HAS_POSTGRES @CSILK_HAS_POSTGRES@)
set(CSILK_HAS_REDIS @CSILK_HAS_REDIS@)
set(CSILK_HAS_MONGODB @HAS_MONGODB@)

if(CSILK_HAS_MYSQL AND NOT TARGET csilk::mysql)
  find_library(MYSQL_LIB NAMES mysqlclient libmysqlclient)
  if(MYSQL_LIB)
    add_library(csilk::mysql INTERFACE IMPORTED)
    set_target_properties(csilk::mysql PROPERTIES INTERFACE_LINK_LIBRARIES "${MYSQL_LIB}")
  endif()
endif()
if(CSILK_HAS_POSTGRES AND NOT TARGET csilk::pq)
  find_library(PQ_LIB NAMES pq libpq)
  if(PQ_LIB)
    add_library(csilk::pq INTERFACE IMPORTED)
    set_target_properties(csilk::pq PROPERTIES INTERFACE_LINK_LIBRARIES "${PQ_LIB}")
  endif()
endif()
if(CSILK_HAS_REDIS AND NOT TARGET csilk::hiredis)
  find_library(HIREDIS_LIB NAMES hiredis)
  if(HIREDIS_LIB)
    add_library(csilk::hiredis INTERFACE IMPORTED)
    set_target_properties(csilk::hiredis PROPERTIES INTERFACE_LINK_LIBRARIES "${HIREDIS_LIB}")
  endif()
endif()
if(CSILK_HAS_MONGODB AND NOT TARGET csilk::mongoc)
  find_library(MONGOC_LIB NAMES mongoc-1.0)
  find_library(BSON_LIB NAMES bson-1.0)
  if(MONGOC_LIB AND BSON_LIB)
    add_library(csilk::mongoc INTERFACE IMPORTED)
    set_target_properties(csilk::mongoc PROPERTIES INTERFACE_LINK_LIBRARIES "${MONGOC_LIB};${BSON_LIB}")
  endif()
endif()

# ── Include Exported Targets ──────────────────────────────────────────────
include("${CMAKE_CURRENT_LIST_DIR}/csilk-targets.cmake")

# ── Convenience Aliases ───────────────────────────────────────────────────
foreach(_mod base core http tls http2 db ai mq workflow json wasm bypass)
  if(TARGET csilk::csilk_${_mod} AND NOT TARGET csilk::${_mod})
    add_library(csilk::${_mod} INTERFACE IMPORTED)
    target_link_libraries(csilk::${_mod} INTERFACE csilk::csilk_${_mod})
  endif()
  if(TARGET csilk::csilk_${_mod}_shared AND NOT TARGET csilk::${_mod}_shared)
    add_library(csilk::${_mod}_shared INTERFACE IMPORTED)
    target_link_libraries(csilk::${_mod}_shared INTERFACE csilk::csilk_${_mod}_shared)
  endif()
endforeach()

check_required_components(csilk)
