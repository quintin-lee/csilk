@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# ── Package Feature Configuration ─────────────────────────────────────────
set(CSILK_BUILD_SHARED "@CSILK_BUILD_SHARED@")
set(CSILK_USE_URING "@CSILK_USE_URING@")
set(CSILK_ENABLE_DB "@CSILK_ENABLE_DB@")
set(CSILK_ENABLE_MQ "@CSILK_ENABLE_MQ@")
set(CSILK_ENABLE_AI "@CSILK_ENABLE_AI@")
set(CSILK_ENABLE_VECTOR "@CSILK_ENABLE_VECTOR@")
set(CSILK_ENABLE_MCP "@CSILK_ENABLE_MCP@")
set(CSILK_ENABLE_WORKFLOW "@CSILK_ENABLE_WORKFLOW@")
set(CSILK_ENABLE_GRPC "@CSILK_ENABLE_GRPC@")
set(CSILK_ENABLE_WASM "@CSILK_ENABLE_WASM@")
set(CSILK_ENABLE_BYPASS "@CSILK_ENABLE_BYPASS@")
set(CSILK_ENABLE_PERM "@CSILK_ENABLE_PERM@")
set(CSILK_ENABLE_HTTP3 "@CSILK_ENABLE_HTTP3@")
set(CSILK_ENABLE_OBSERVABILITY "@CSILK_ENABLE_OBSERVABILITY@")
set(CSILK_ENABLE_CSV "@CSILK_ENABLE_CSV@")
set(CSILK_NEED_CURL "@CSILK_NEED_CURL@")

# ── Standard CMake Package Dependencies ──────────────────────────────────
find_dependency(Threads)
find_dependency(OpenSSL)
find_dependency(ZLIB)
if(CSILK_ENABLE_DB)
  find_dependency(SQLite3)
endif()
if(CSILK_NEED_CURL)
  find_dependency(CURL)
endif()

if(TARGET SQLite::SQLite3 AND NOT TARGET SQLite3::SQLite3)
  add_library(SQLite3::SQLite3 INTERFACE IMPORTED)
  target_link_libraries(SQLite3::SQLite3 INTERFACE SQLite::SQLite3)
endif()
if(TARGET SQLite3::SQLite3 AND NOT TARGET SQLite::SQLite3)
  add_library(SQLite::SQLite3 INTERFACE IMPORTED)
  target_link_libraries(SQLite::SQLite3 INTERFACE SQLite3::SQLite3)
endif()

# ── JSON Engine (yyjson) ──────────────────────────────────────────────────
if(NOT TARGET yyjson::yyjson AND NOT TARGET yyjson)
  find_package(yyjson QUIET)
  if(NOT TARGET yyjson::yyjson AND NOT TARGET yyjson)
    if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/../yyjson/yyjson-config.cmake")
      include("${CMAKE_CURRENT_LIST_DIR}/../yyjson/yyjson-config.cmake")
    endif()
  endif()
endif()
if(TARGET yyjson AND NOT TARGET yyjson::yyjson)
  add_library(yyjson::yyjson INTERFACE IMPORTED)
  target_link_libraries(yyjson::yyjson INTERFACE yyjson)
endif()

# ── I/O Backend (libuv or io_uring) ──────────────────────────────────────
if(CSILK_USE_URING AND NOT TARGET uring)
  find_library(URING_LIB NAMES uring liburing)
  if(URING_LIB)
    add_library(uring INTERFACE IMPORTED)
    set_target_properties(uring PROPERTIES INTERFACE_LINK_LIBRARIES "${URING_LIB}")
    find_path(URING_INCLUDE_DIR liburing.h)
    if(URING_INCLUDE_DIR)
      set_target_properties(uring PROPERTIES INTERFACE_INCLUDE_DIRECTORIES "${URING_INCLUDE_DIR}")
    endif()
  endif()
endif()
if(NOT CSILK_USE_URING AND NOT TARGET csilk::libuv)
  find_package(PkgConfig QUIET)
  if(PKG_CONFIG_FOUND)
    pkg_check_modules(LIBUV QUIET IMPORTED_TARGET libuv)
  endif()
  if(NOT TARGET PkgConfig::LIBUV)
    find_library(LIBUV_LIB NAMES uv libuv)
    find_path(LIBUV_INCLUDE_DIR uv.h)
    if(LIBUV_LIB)
      add_library(PkgConfig::LIBUV INTERFACE IMPORTED)
      if(LIBUV_INCLUDE_DIR)
        set_target_properties(PkgConfig::LIBUV PROPERTIES INTERFACE_INCLUDE_DIRECTORIES "${LIBUV_INCLUDE_DIR}")
      endif()
      set_target_properties(PkgConfig::LIBUV PROPERTIES INTERFACE_LINK_LIBRARIES "${LIBUV_LIB}")
    endif()
  endif()
  # Always define csilk::libuv: exported csilk targets unconditionally list
  # it in INTERFACE_LINK_LIBRARIES, so leaving the target undefined makes
  # find_package(csilk) fail in consumers.
  add_library(csilk::libuv INTERFACE IMPORTED)
  if(TARGET PkgConfig::LIBUV)
    target_link_libraries(csilk::libuv INTERFACE PkgConfig::LIBUV)
  else()
    find_library(LIBUV_LIB NAMES uv libuv)
    if(LIBUV_LIB)
      set_target_properties(csilk::libuv PROPERTIES INTERFACE_LINK_LIBRARIES "${LIBUV_LIB}")
    endif()
    find_path(LIBUV_INCLUDE_DIR uv.h)
    if(LIBUV_INCLUDE_DIR)
      set_target_properties(csilk::libuv PROPERTIES INTERFACE_INCLUDE_DIRECTORIES "${LIBUV_INCLUDE_DIR}")
    endif()
  endif()
endif()

# ── YAML Parser (libyaml) ─────────────────────────────────────────────────
if(NOT TARGET csilk::yaml)
  find_package(PkgConfig QUIET)
  if(PKG_CONFIG_FOUND)
    pkg_check_modules(YAML QUIET IMPORTED_TARGET yaml>=0.2.0)
  endif()
  if(TARGET PkgConfig::YAML)
    add_library(csilk::yaml INTERFACE IMPORTED)
    target_link_libraries(csilk::yaml INTERFACE PkgConfig::YAML)
  else()
    find_library(YAML_LIB NAMES yaml libyaml)
    find_path(YAML_INCLUDE_DIR yaml.h PATH_SUFFIXES yaml)
    if(YAML_LIB)
      add_library(csilk::yaml INTERFACE IMPORTED)
      if(YAML_INCLUDE_DIR)
        set_target_properties(csilk::yaml PROPERTIES INTERFACE_INCLUDE_DIRECTORIES "${YAML_INCLUDE_DIR}")
      endif()
      set_target_properties(csilk::yaml PROPERTIES INTERFACE_LINK_LIBRARIES "${YAML_LIB}")
    endif()
  endif()
endif()

# ── HTTP/1 Parser (llhttp) ────────────────────────────────────────────────
if(NOT TARGET csilk::llhttp)
  find_library(LLHTTP_LIB NAMES llhttp libllhttp)
  find_path(LLHTTP_INCLUDE_DIR llhttp.h)
  if(LLHTTP_LIB)
    add_library(csilk::llhttp INTERFACE IMPORTED)
    if(LLHTTP_INCLUDE_DIR)
      set_target_properties(csilk::llhttp PROPERTIES INTERFACE_INCLUDE_DIRECTORIES "${LLHTTP_INCLUDE_DIR}")
    endif()
    set_target_properties(csilk::llhttp PROPERTIES INTERFACE_LINK_LIBRARIES "${LLHTTP_LIB}")
  endif()
endif()

# ── HTTP/2 Engine (nghttp2) ───────────────────────────────────────────────
# Exported csilk targets may reference either the alias nghttp2::nghttp2 (from
# a system/FetchContent import) or the plain name nghttp2; define whichever the
# consumer is missing so find_package(csilk) resolves both spellings.
if(NOT TARGET nghttp2 AND NOT TARGET nghttp2::nghttp2)
  find_package(PkgConfig QUIET)
  if(PKG_CONFIG_FOUND)
    pkg_check_modules(LIBNGHTTP2 QUIET IMPORTED_TARGET libnghttp2)
  endif()
  if(TARGET PkgConfig::LIBNGHTTP2)
    add_library(nghttp2::nghttp2 INTERFACE IMPORTED)
    target_link_libraries(nghttp2::nghttp2 INTERFACE PkgConfig::LIBNGHTTP2)
  else()
    find_library(NGHTTP2_LIB NAMES nghttp2 libnghttp2)
    find_path(NGHTTP2_INCLUDE_DIR nghttp2/nghttp2.h)
    if(NGHTTP2_LIB)
      add_library(nghttp2::nghttp2 INTERFACE IMPORTED)
      if(NGHTTP2_INCLUDE_DIR)
        set_target_properties(nghttp2::nghttp2 PROPERTIES INTERFACE_INCLUDE_DIRECTORIES "${NGHTTP2_INCLUDE_DIR}")
      endif()
      set_target_properties(nghttp2::nghttp2 PROPERTIES INTERFACE_LINK_LIBRARIES "${NGHTTP2_LIB}")
    endif()
  endif()
endif()
if(TARGET nghttp2::nghttp2 AND NOT TARGET nghttp2)
  add_library(nghttp2 INTERFACE IMPORTED)
  target_link_libraries(nghttp2 INTERFACE nghttp2::nghttp2)
elseif(TARGET nghttp2 AND NOT TARGET nghttp2::nghttp2)
  add_library(nghttp2::nghttp2 INTERFACE IMPORTED)
  target_link_libraries(nghttp2::nghttp2 INTERFACE nghttp2)
endif()

# ── HTTP/3 Engine (ngtcp2 + nghttp3) ──────────────────────────────────────
if(CSILK_ENABLE_HTTP3)
  if(NOT TARGET csilk::ngtcp2)
    find_package(PkgConfig QUIET)
    if(PKG_CONFIG_FOUND)
      pkg_check_modules(LIBNGTCP2 QUIET IMPORTED_TARGET libngtcp2)
      pkg_check_modules(LIBNGTCP2_CRYPTO_OSSL QUIET IMPORTED_TARGET libngtcp2_crypto_ossl)
    endif()
    if(TARGET PkgConfig::LIBNGTCP2)
      add_library(csilk::ngtcp2 INTERFACE IMPORTED)
      set(_csilk_ngtcp2_libs PkgConfig::LIBNGTCP2)
      if(TARGET PkgConfig::LIBNGTCP2_CRYPTO_OSSL)
        list(APPEND _csilk_ngtcp2_libs PkgConfig::LIBNGTCP2_CRYPTO_OSSL)
      else()
        find_library(NGTCP2_CRYPTO_OSSL_LIB NAMES ngtcp2_crypto_ossl libngtcp2_crypto_ossl
          HINTS "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@" "${PACKAGE_PREFIX_DIR}/lib" "${PACKAGE_PREFIX_DIR}/lib64")
        if(NGTCP2_CRYPTO_OSSL_LIB)
          list(APPEND _csilk_ngtcp2_libs "${NGTCP2_CRYPTO_OSSL_LIB}")
        endif()
      endif()
      list(APPEND _csilk_ngtcp2_libs OpenSSL::SSL OpenSSL::Crypto)
      target_link_libraries(csilk::ngtcp2 INTERFACE ${_csilk_ngtcp2_libs})
    else()
      find_library(NGTCP2_LIB NAMES ngtcp2 libngtcp2
        HINTS "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@" "${PACKAGE_PREFIX_DIR}/lib" "${PACKAGE_PREFIX_DIR}/lib64")
      find_path(NGTCP2_INCLUDE_DIR ngtcp2/ngtcp2.h
        HINTS "${PACKAGE_PREFIX_DIR}/include")
      find_library(NGTCP2_CRYPTO_OSSL_LIB NAMES ngtcp2_crypto_ossl libngtcp2_crypto_ossl
        HINTS "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@" "${PACKAGE_PREFIX_DIR}/lib" "${PACKAGE_PREFIX_DIR}/lib64")
      if(NGTCP2_LIB)
        add_library(csilk::ngtcp2 INTERFACE IMPORTED)
        if(NGTCP2_INCLUDE_DIR)
          set_target_properties(csilk::ngtcp2 PROPERTIES INTERFACE_INCLUDE_DIRECTORIES "${NGTCP2_INCLUDE_DIR}")
        endif()
        set(_csilk_ngtcp2_libs "${NGTCP2_LIB}")
        if(NGTCP2_CRYPTO_OSSL_LIB)
          list(APPEND _csilk_ngtcp2_libs "${NGTCP2_CRYPTO_OSSL_LIB}")
        endif()
        list(APPEND _csilk_ngtcp2_libs OpenSSL::SSL OpenSSL::Crypto)
        set_target_properties(csilk::ngtcp2 PROPERTIES INTERFACE_LINK_LIBRARIES "${_csilk_ngtcp2_libs}")
      endif()
    endif()
  endif()

  if(NOT TARGET csilk::nghttp3)
    find_package(PkgConfig QUIET)
    if(PKG_CONFIG_FOUND)
      pkg_check_modules(LIBNGHTTP3 QUIET IMPORTED_TARGET libnghttp3)
    endif()
    if(TARGET PkgConfig::LIBNGHTTP3)
      add_library(csilk::nghttp3 INTERFACE IMPORTED)
      target_link_libraries(csilk::nghttp3 INTERFACE PkgConfig::LIBNGHTTP3)
    else()
      find_library(NGHTTP3_LIB NAMES nghttp3 libnghttp3
        HINTS "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@" "${PACKAGE_PREFIX_DIR}/lib" "${PACKAGE_PREFIX_DIR}/lib64")
      find_path(NGHTTP3_INCLUDE_DIR nghttp3/nghttp3.h
        HINTS "${PACKAGE_PREFIX_DIR}/include")
      if(NGHTTP3_LIB)
        add_library(csilk::nghttp3 INTERFACE IMPORTED)
        if(NGHTTP3_INCLUDE_DIR)
          set_target_properties(csilk::nghttp3 PROPERTIES INTERFACE_INCLUDE_DIRECTORIES "${NGHTTP3_INCLUDE_DIR}")
        endif()
        set_target_properties(csilk::nghttp3 PROPERTIES INTERFACE_LINK_LIBRARIES "${NGHTTP3_LIB}")
      endif()
    endif()
  endif()
endif()

# ── WAMR Runtime (vmlib) ──────────────────────────────────────────────────
if(CSILK_ENABLE_WASM)
  if(NOT TARGET csilk::vmlib AND NOT TARGET vmlib)
    find_library(VMLIB_LIB NAMES vmlib libvmlib
      HINTS "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@" "${PACKAGE_PREFIX_DIR}/lib" "${PACKAGE_PREFIX_DIR}/lib64")
    if(VMLIB_LIB)
      add_library(csilk::vmlib INTERFACE IMPORTED)
      set(_csilk_vmlib_libs "${VMLIB_LIB}" Threads::Threads)
      if(NOT APPLE AND NOT WIN32)
        list(APPEND _csilk_vmlib_libs m ${CMAKE_DL_LIBS})
      endif()
      set_target_properties(csilk::vmlib PROPERTIES INTERFACE_LINK_LIBRARIES "${_csilk_vmlib_libs}")
    endif()
  endif()
  if(TARGET csilk::vmlib AND NOT TARGET vmlib)
    add_library(vmlib INTERFACE IMPORTED)
    target_link_libraries(vmlib INTERFACE csilk::vmlib)
  elseif(TARGET vmlib AND NOT TARGET csilk::vmlib)
    add_library(csilk::vmlib INTERFACE IMPORTED)
    target_link_libraries(csilk::vmlib INTERFACE vmlib)
  endif()
endif()

# ── Optional Database Drivers ─────────────────────────────────────────────
set(CSILK_HAS_MYSQL "@CSILK_HAS_MYSQL@")
set(CSILK_HAS_POSTGRES "@CSILK_HAS_POSTGRES@")
set(CSILK_HAS_REDIS "@CSILK_HAS_REDIS@")
set(CSILK_HAS_MONGODB "@HAS_MONGODB@")

if(CSILK_HAS_MYSQL AND NOT TARGET csilk::mysql)
  find_library(MYSQL_LIB NAMES mysqlclient libmysqlclient)
  if(MYSQL_LIB)
    add_library(csilk::mysql INTERFACE IMPORTED)
    set_target_properties(csilk::mysql PROPERTIES INTERFACE_LINK_LIBRARIES "${MYSQL_LIB}")
  endif()
endif()
if(CSILK_HAS_POSTGRES AND NOT TARGET csilk::pq)
  find_library(PQ_LIB NAMES pq libpq)
  if(PQ_LIB)
    add_library(csilk::pq INTERFACE IMPORTED)
    set_target_properties(csilk::pq PROPERTIES INTERFACE_LINK_LIBRARIES "${PQ_LIB}")
  endif()
endif()
if(CSILK_HAS_REDIS AND NOT TARGET csilk::hiredis)
  find_library(HIREDIS_LIB NAMES hiredis)
  if(HIREDIS_LIB)
    add_library(csilk::hiredis INTERFACE IMPORTED)
    set_target_properties(csilk::hiredis PROPERTIES INTERFACE_LINK_LIBRARIES "${HIREDIS_LIB}")
  endif()
endif()
if(CSILK_HAS_MONGODB AND NOT TARGET csilk::mongoc)
  find_library(MONGOC_LIB NAMES mongoc-1.0)
  find_library(BSON_LIB NAMES bson-1.0)
  if(MONGOC_LIB AND BSON_LIB)
    add_library(csilk::mongoc INTERFACE IMPORTED)
    set_target_properties(csilk::mongoc PROPERTIES INTERFACE_LINK_LIBRARIES "${MONGOC_LIB};${BSON_LIB}")
  endif()
endif()

# ── Include Exported Targets ──────────────────────────────────────────────
include("${CMAKE_CURRENT_LIST_DIR}/csilk-targets.cmake")

# ── Convenience Aliases ───────────────────────────────────────────────────
foreach(_mod base core crypto runtime http tls http2 h3 protocols mcp grpc middleware reflection permission app db vector ai mq workflow json wasm bypass observability)
  if(TARGET csilk::csilk_${_mod} AND NOT TARGET csilk::${_mod})
    add_library(csilk::${_mod} INTERFACE IMPORTED)
    target_link_libraries(csilk::${_mod} INTERFACE csilk::csilk_${_mod})
  endif()
  if(TARGET csilk::csilk_${_mod}_shared AND NOT TARGET csilk::${_mod}_shared)
    add_library(csilk::${_mod}_shared INTERFACE IMPORTED)
    target_link_libraries(csilk::${_mod}_shared INTERFACE csilk::csilk_${_mod}_shared)
  endif()
endforeach()

if(TARGET csilk::csilk_shared AND NOT TARGET csilk::shared)
  add_library(csilk::shared INTERFACE IMPORTED)
  target_link_libraries(csilk::shared INTERFACE csilk::csilk_shared)
endif()

check_required_components(csilk)
