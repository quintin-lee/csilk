prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: csilk-grpc
Description: Csilk gRPC wire codec and HTTP/JSON transcoding gateway
Version: @CSILK_VERSION@
URL: https://github.com/quintin-lee/csilk
Requires: @CSILK_GRPC_PC_REQUIRES@
Requires.private: @CSILK_GRPC_PC_REQUIRES_PRIVATE@
Libs: -L${libdir} -lcsilk-grpc
Libs.private: @CSILK_GRPC_PC_LIBS_PRIVATE@
Cflags: -I${includedir} -D_GNU_SOURCE -pthread
