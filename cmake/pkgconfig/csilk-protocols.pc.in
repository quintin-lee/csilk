prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: csilk-protocols
Description: Csilk WebSocket, OpenAPI, Swagger, MCP, and protocol adapters
Version: @CSILK_VERSION@
URL: https://github.com/quintin-lee/csilk
Requires: @CSILK_PROTOCOLS_PC_REQUIRES@
Requires.private: @CSILK_PROTOCOLS_PC_REQUIRES_PRIVATE@
Libs: -L${libdir} -lcsilk-protocols
Libs.private: @CSILK_PROTOCOLS_PC_LIBS_PRIVATE@
Cflags: -I${includedir} -D_GNU_SOURCE -pthread
