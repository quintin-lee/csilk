prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: csilk-runtime
Description: Csilk runtime context, router, server, and I/O backend
Version: @CSILK_VERSION@
URL: https://github.com/quintin-lee/csilk
Requires: @CSILK_RUNTIME_PC_REQUIRES@
Requires.private: @CSILK_RUNTIME_PC_REQUIRES_PRIVATE@
Libs: -L${libdir} -lcsilk-runtime
Libs.private: @CSILK_RUNTIME_PC_LIBS_PRIVATE@
Cflags: -I${includedir} -D_GNU_SOURCE -pthread
