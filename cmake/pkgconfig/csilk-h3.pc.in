prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: csilk-h3
Description: Csilk HTTP/3 and QUIC transport engine (ngtcp2 + nghttp3)
Version: @CSILK_VERSION@
URL: https://github.com/quintin-lee/csilk
Requires: @CSILK_H3_PC_REQUIRES@
Requires.private: @CSILK_H3_PC_REQUIRES_PRIVATE@
Libs: -L${libdir} -lcsilk-h3
Libs.private: @CSILK_H3_PC_LIBS_PRIVATE@
Cflags: -I${includedir} -D_GNU_SOURCE -pthread
