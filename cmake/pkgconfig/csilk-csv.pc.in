prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: csilk-csv
Description: Csilk RFC 4180 CSV parser and serializer utility
Version: @CSILK_VERSION@
URL: https://github.com/quintin-lee/csilk
Requires:
Requires.private: @CSILK_CSV_PC_REQUIRES_PRIVATE@
Libs: -L${libdir} -lcsilk-csv
Libs.private: @CSILK_CSV_PC_LIBS_PRIVATE@
Cflags: -I${includedir} -D_GNU_SOURCE -pthread
