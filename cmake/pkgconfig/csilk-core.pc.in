prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: csilk-core
Description: Csilk core runtime (arena, context, router, primitives)
Version: @CSILK_VERSION@
URL: https://github.com/quintin-lee/csilk
Requires: csilk-base csilk-json
Libs: -L${libdir} -lcsilk-core
Libs.private: @CSILK_CORE_PC_LIBS_PRIVATE@
Requires.private: @CSILK_CORE_PC_REQUIRES_PRIVATE@
Cflags: -I${includedir} -D_GNU_SOURCE -pthread
