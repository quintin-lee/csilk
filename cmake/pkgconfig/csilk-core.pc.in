prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: csilk-core
Description: Csilk core compatibility package backed by the runtime target
Version: @CSILK_VERSION@
URL: https://github.com/quintin-lee/csilk
Requires: csilk-runtime
Libs: -L${libdir}
Libs.private: @CSILK_CORE_PC_LIBS_PRIVATE@
Requires.private: @CSILK_CORE_PC_REQUIRES_PRIVATE@
Cflags: -I${includedir} -D_GNU_SOURCE -pthread
