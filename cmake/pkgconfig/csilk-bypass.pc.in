prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: csilk-bypass
Description: Csilk AF_XDP and DPDK kernel bypass acceleration engine
Version: @CSILK_VERSION@
URL: https://github.com/quintin-lee/csilk
Requires: @CSILK_BYPASS_PC_REQUIRES@
Libs: -L${libdir} -lcsilk-bypass
Cflags: -I${includedir} -D_GNU_SOURCE
