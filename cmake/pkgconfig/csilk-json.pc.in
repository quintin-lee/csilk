prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: csilk-json
Description: Csilk fast JSON serialization engine
Version: @CSILK_VERSION@
URL: https://github.com/quintin-lee/csilk
Requires: @CSILK_JSON_PC_REQUIRES@
Libs: -L${libdir} -lcsilk-json
Libs.private: @CSILK_JSON_PC_LIBS_PRIVATE@
Cflags: -I${includedir} -D_GNU_SOURCE -pthread
