prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: csilk
Description: High-performance, lightweight C HTTP server and microservices framework
Version: @CSILK_VERSION@
URL: https://github.com/quintin-lee/csilk
Requires: csilk-http csilk-db csilk-workflow csilk-wasm
Libs: -L${libdir}
Cflags: -I${includedir} -D_GNU_SOURCE
