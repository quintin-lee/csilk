prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: csilk-app
Description: Csilk application builder, groups, routes, and admin API
Version: @CSILK_VERSION@
URL: https://github.com/quintin-lee/csilk
Requires: @CSILK_APP_PC_REQUIRES@
Requires.private: @CSILK_APP_PC_REQUIRES_PRIVATE@
Libs: -L${libdir} -lcsilk-app
Libs.private: @CSILK_APP_PC_LIBS_PRIVATE@
Cflags: -I${includedir} -D_GNU_SOURCE -pthread
