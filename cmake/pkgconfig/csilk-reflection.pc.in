prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: csilk-reflection
Description: Csilk reflection marshal and unmarshal support
Version: @CSILK_VERSION@
URL: https://github.com/quintin-lee/csilk
Requires: @CSILK_REFLECTION_PC_REQUIRES@
Requires.private: @CSILK_REFLECTION_PC_REQUIRES_PRIVATE@
Libs: -L${libdir} -lcsilk-reflection
Libs.private: @CSILK_REFLECTION_PC_LIBS_PRIVATE@
Cflags: -I${includedir} -D_GNU_SOURCE -pthread
