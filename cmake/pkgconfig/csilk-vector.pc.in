prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: csilk-vector
Description: Csilk embedded vector database and remote vector adapters
Version: @CSILK_VERSION@
URL: https://github.com/quintin-lee/csilk
Requires: @CSILK_VECTOR_PC_REQUIRES@
Requires.private: @CSILK_VECTOR_PC_REQUIRES_PRIVATE@
Libs: -L${libdir} -lcsilk-vector
Libs.private: @CSILK_VECTOR_PC_LIBS_PRIVATE@
Cflags: -I${includedir} -D_GNU_SOURCE -pthread
