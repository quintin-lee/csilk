prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: csilk-wasm
Description: Csilk WASM VM and WASI plugin sandbox engine
Version: @CSILK_VERSION@
URL: https://github.com/quintin-lee/csilk
Requires: @CSILK_WASM_PC_REQUIRES@
Libs: -L${libdir} -lcsilk-wasm
Cflags: -I${includedir}
