prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: csilk-permission
Description: Csilk pluggable permission and in-memory RBAC driver
Version: @CSILK_VERSION@
URL: https://github.com/quintin-lee/csilk
Requires: @CSILK_PERMISSION_PC_REQUIRES@
Requires.private: @CSILK_PERMISSION_PC_REQUIRES_PRIVATE@
Libs: -L${libdir} -lcsilk-permission
Libs.private: @CSILK_PERMISSION_PC_LIBS_PRIVATE@
Cflags: -I${includedir} -D_GNU_SOURCE -pthread
