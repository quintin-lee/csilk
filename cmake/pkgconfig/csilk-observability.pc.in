prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: csilk-observability
Description: Csilk OTLP tracing, CPU flamegraph profiler, and Admin/APM dashboard
Version: @CSILK_VERSION@
URL: https://github.com/quintin-lee/csilk
Requires: @CSILK_OBSERVABILITY_PC_REQUIRES@
Requires.private: @CSILK_OBSERVABILITY_PC_REQUIRES_PRIVATE@
Libs: -L${libdir} -lcsilk-observability
Libs.private: @CSILK_OBSERVABILITY_PC_LIBS_PRIVATE@
Cflags: -I${includedir} -D_GNU_SOURCE -pthread
