prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: csilk-db
Description: Csilk database abstraction and connection pools
Version: @CSILK_VERSION@
URL: https://github.com/quintin-lee/csilk
Requires: csilk-core
Requires.private: @CSILK_DB_PC_REQUIRES_PRIVATE@
Libs: -L${libdir} -lcsilk-db
Libs.private: @CSILK_DB_PC_LIBS_PRIVATE@
Cflags: -I${includedir} -D_GNU_SOURCE
