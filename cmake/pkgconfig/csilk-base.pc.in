prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: csilk-base
Description: Csilk foundation primitives (arena, bounded buffer, kv store)
Version: @CSILK_VERSION@
URL: https://github.com/quintin-lee/csilk
Libs: -L${libdir} -lcsilk-base
Libs.private: @CSILK_BASE_PC_LIBS_PRIVATE@
Cflags: -I${includedir} -D_GNU_SOURCE
