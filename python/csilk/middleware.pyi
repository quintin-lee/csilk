from csilk.context import Context

class CircuitBreaker:
    def __init__(self, failure_threshold: int = ..., recovery_timeout_ms: int = ...) -> None: ...
    def middleware(self, ctx: Context) -> None: ...
    def record_success(self) -> None: ...
    def record_failure(self) -> None: ...
    @property
    def state(self) -> int: ...
    def __del__(self) -> None: ...

class SlidingLimiter:
    def __init__(self, limit_per_window: int = ..., window_ms: int = ...) -> None: ...
    def middleware(self, ctx: Context) -> None: ...
    def __del__(self) -> None: ...

def trace_middleware(ctx: Context) -> None: ...
